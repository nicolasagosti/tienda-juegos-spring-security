# ==========================================================
# Copiar a  .env  y completar antes de:
#   docker compose -f docker-compose.prod.yml up -d --build
# El archivo .env NO se commitea (esta en .gitignore).
# ==========================================================

# --- Dominio del gateway (donde apunta el registro A/AAAA del VPS) ---
# Solo se usan con Caddy (docker-compose.prod.yml a secas). Con Cloudflare
# Tunnel (override docker-compose.cloudflare.yml) los ignora: dejar cualquier valor.
DOMAIN=api.tudominio.com
TLS_EMAIL=vos@tudominio.com

# --- Cloudflare Tunnel (solo si usas docker-compose.cloudflare.yml) ---
# Token del tunnel: Cloudflare -> Zero Trust -> Networks -> Tunnels ->
# Create a tunnel (tipo "Cloudflared"). Ver docker-compose.cloudflare.yml.
TUNNEL_TOKEN=

# --- Secreto de la API interna entre servicios (header X-Internal-Token) ---
# Generar uno nuevo:  openssl rand -hex 32
INTERNAL_SECRET=CAMBIAR

# --- Passwords de las bases (auth-service y negocio-service) ---
# Generar:  openssl rand -hex 16
AUTH_DB_PASSWORD=CAMBIAR
NEGOCIO_DB_PASSWORD=CAMBIAR

# --- Frontend en Vercel ---
# Origenes que pueden llamar a /api/** (coma-separado; admite comodines
# para las preview deployments de Vercel).
GATEWAY_ALLOWED_ORIGINS=https://tu-app.vercel.app,https://tu-app-*.vercel.app
# URL del frontend SIN barra final (a donde redirige el login con Google).
FRONTEND_URL=https://tu-app.vercel.app

# --- Login con Google (opcional) ---
# Vacios: la app arranca igual y el boton "Continuar con Google" queda inerte.
# Redirect URI autorizada en Google Cloud Console:
#   https://api.tudominio.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

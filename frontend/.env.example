# Copiar a ".env.local" para desarrollo, o cargar como variables de
# entorno del proyecto en el dashboard de Vercel (Settings > Environment
# Variables) para el deploy real.

# URL base del backend. En local, dejar vacio (usa "/api" relativo, sirve
# tanto para el modo embebido como para "npm run dev" con el proxy de
# vite.config.js). En Vercel, poner la URL publica del backend desplegado
# en Render/Railway/etc, terminada en "/api":
#   VITE_API_BASE_URL=https://tienda-juegos-backend.onrender.com/api
VITE_API_BASE_URL=

# Poner en "true" SOLO en Vercel (o cualquier build standalone separado
# del backend). Sin esta variable, "npm run build" genera el build
# "embebido" que espera vivir adentro del backend Spring Boot.
VITE_STANDALONE_BUILD=false

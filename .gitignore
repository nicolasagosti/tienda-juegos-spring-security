target/
*.class
*.log
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
HELP.md

# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/

# El build de React embebido se genera dentro del gateway; no se versiona.
# Se regenera con "npm run build" (ver frontend/vite.config.js).
services/api-gateway/src/main/resources/static/*
!services/api-gateway/src/main/resources/static/.gitkeep

# Imagenes subidas en tiempo de ejecucion (catalogo-service, perfil dev).
# La carpeta "uploads" se crea donde se ejecute el servicio (cwd).
/uploads/
services/catalogo-service/uploads/
legacy-monolith/uploads/*
!legacy-monolith/uploads/.gitkeep

# El monolito original queda como referencia; su build de React no se versiona
legacy-monolith/src/main/resources/static/*
!legacy-monolith/src/main/resources/static/.gitkeep

# --- Claves JWT de PRODUCCION ---
# Las de la demo (keys/jwt-*.pem y las copias en cada servicio) SI se
# versionan a proposito, igual que el "demo-secret" del monolito. Si
# generas un par real para produccion, ignoralo:
# keys/jwt-private.pem

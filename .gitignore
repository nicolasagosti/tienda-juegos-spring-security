# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/

# El build de React embebido se genera dentro del gateway; no se versiona
# (ni el directorio: el gateway arranca igual sin el, ver SpaFallbackConfig).
# Se regenera con "npm run build" (ver frontend/vite.config.js).
backend/api-gateway/src/main/resources/static/

# Imagenes subidas en tiempo de ejecucion (negocio-service, perfil dev).
# La carpeta "uploads" se crea donde se ejecute el servicio (cwd).
/uploads/
backend/negocio-service/uploads/

# Arbol viejo "services/": la migracion a "backend/" ya esta hecha. La
# extension de modernizacion de VSCode a veces lo recrea con basura de
# build; que no vuelva a colarse en un commit.
/services/

